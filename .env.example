# Copia este archivo como .env y llena los valores.
# El .env NUNCA se sube a GitHub (está en .gitignore).

# Puerto del servidor local
PORT=3000

# OpenAI — Etapa 2
OPENAI_API_KEY=
# Niveles disponibles, de mas barato a mas caro:
#   gpt-5.6-luna   $0.20 / $1.20  por millon de tokens (entrada/salida)
#   gpt-5.6-terra  $2.00 / $12.00
#   gpt-5.6-sol    $5.00 / $30.00
OPENAI_MODEL=gpt-5.6-luna

# Supabase — Etapas 3 y 4
# Usa la llave ANONIMA (anon public), no la service_role. El backend solo lee,
# y la politica RLS de schema.sql ya limita esa llave a lo publicado.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Seguridad de /api/chat — Etapa 5
# Credencial que debe mandar quien llame a /api/chat en el header x-api-key.
# El webhook de Meta NO la usa: se autentica con la firma del App Secret.
CHAT_API_KEY=
# Dominios del propio frontend con permiso de llamar por CORS, separados por
# comas. Vacio = ningun navegador puede llamar (solo curl/backend a backend).
CORS_ORIGINS=

# Meta (Instagram / Facebook / WhatsApp) — Etapa 6 en adelante
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_APP_SECRET=
