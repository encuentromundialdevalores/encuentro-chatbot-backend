# Copia este archivo como .env y llena los valores.
# El .env NUNCA se sube a GitHub (está en .gitignore).

# Puerto del servidor local
PORT=3000

# OpenAI — Etapa 2
OPENAI_API_KEY=
# Niveles disponibles, de mas barato a mas caro:
#   gpt-5.6-luna   $0.20 / $1.20  por millon de tokens (entrada/salida)
#   gpt-5.6-terra  $2.00 / $12.00
#   gpt-5.6-sol    $5.00 / $30.00
OPENAI_MODEL=gpt-5.6-luna

# Meta (Instagram / Facebook / WhatsApp) — Etapa 6 en adelante
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_APP_SECRET=
